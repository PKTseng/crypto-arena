# ── WalletConnect ─────────────────────────────────────────────────────────
# 在 https://cloud.walletconnect.com 免費申請
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ── Sepolia Contract ──────────────────────────────────────────────────────
# 執行 npx hardhat run scripts/deploy.ts --network sepolia 後填入
NEXT_PUBLIC_ARENA_BET_ADDRESS=

# ── Hardhat Deployment ────────────────────────────────────────────────────
# 部署用錢包私鑰（不要前綴 0x，不要提交到 git）
DEPLOYER_PRIVATE_KEY=your_private_key_without_0x

# Sepolia RPC（免費選項：https://rpc.sepolia.org 或 Alchemy/Infura）
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API Key（選填，用於合約驗證）
ETHERSCAN_API_KEY=
